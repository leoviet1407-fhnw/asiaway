# Copy to .env and fill in. NEVER commit a filled-in .env.

# --- Database -----------------------------------------------------------
# Required in production. Without it, development falls back to an in-process
# PGlite database under .pglite/ so the app runs with no infrastructure.
DATABASE_URL=postgres://asiaway:password@localhost:5432/asiaway
POSTGRES_PASSWORD=change-me

# --- Secrets ------------------------------------------------------------
# Generate each with:  openssl rand -base64 48
# Signs the guest's dining-session cookie. At least 32 characters.
# Changing it invalidates every open guest session.
CUSTOMER_COOKIE_SECRET=
# Reserved for the auth layer.
AUTH_SECRET=

# --- Application --------------------------------------------------------
# Used to build the QR code URLs. Must be the public HTTPS address in production.
APP_BASE_URL=http://localhost:3000

# Timestamps are stored in UTC and rendered in this zone. Confirm with the
# restaurant (open question E8).
NEXT_PUBLIC_RESTAURANT_TIMEZONE=Europe/Zurich

# Sessions idle for this long are auto-closed, so a party that leaves without
# asking for the bill cannot leave their orders attached to the next guests
# (proposal E6 — confirm the value with the restaurant).
SESSION_IDLE_TIMEOUT_HOURS=4

# --- Seeding ------------------------------------------------------------
# The demo seed refuses to touch a DATABASE_URL database unless this is set.
# SEED_ALLOW_PROD=1
# SEED_WAITER_PASSWORD=
