# Copy to .env.local and fill in. NEVER commit a filled-in env file.

# --- Database ------------------------------------------------------------
# Required in production. Without it, development uses an in-process PGlite
# database under .pglite/ (auto-migrated and auto-seeded with sample data).
# DATABASE_URL=postgres://asiaway:password@localhost:5432/asiaway_staff

# --- App -----------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# --- Order emails ----------------------------------------------------------
# console (default): log the email and write it with its PDF to .outbox/
# smtp: send for real through SMTP_URL
MAIL_TRANSPORT=console
# SMTP_URL=smtps://user:password@mail.example.ch:465
ORDER_FROM_EMAIL="AsiaWay Bestellung <bestellung@asiaway.ch>"
# Optional archive copy of every order email
# ORDER_CC_EMAIL=bestellung@asiaway.ch

# --- Seeding ---------------------------------------------------------------
# Password given to the sample users by `npm run seed` / dev auto-seed.
# SEED_PASSWORD=asiaway-dev
# The seed refuses to touch a DATABASE_URL database unless this is set.
# SEED_ALLOW_PROD=1

# --- URL prefix ------------------------------------------------------------
# Empty when the app has its own (sub)domain such as staff.asiaway.ch.
# Set (at BUILD time) when it is served under asiaway.ch, e.g. /staff/app
# NEXT_PUBLIC_BASE_PATH=/staff/app
